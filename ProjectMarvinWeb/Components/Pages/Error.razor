@page "/Error"
@using System.Diagnostics

<PageTitle>Error · Project Marvin</PageTitle>

<div class="acct">
    <div class="acct-auth">
        <div class="acct-card">
            <div class="acct-head">
                <span class="acct-icon danger" aria-hidden="true">
                    <svg viewBox="0 0 16 16" width="18" height="18"><path d="M8 2 1.75 13.5h12.5z" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" /><path d="M8 6.5v3.25M8 11.75v.25" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg>
                </span>
                <h1>Something went wrong</h1>
                <p class="muted">An error occurred while processing your request. It has been logged on the server.</p>
            </div>
            @if (ShowRequestId)
            {
                <p class="small muted">Request ID: <span class="key">@RequestId</span></p>
            }
            <a href="" class="btn btn-secondary btn-block">Go to the log</a>
        </div>
    </div>
</div>

@code{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
