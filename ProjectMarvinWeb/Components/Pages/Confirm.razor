@namespace ProjectMarvin.Components.Pages

@if (IsVisible)
{
  <div class="backdrop" @onclick="() => OnClose.InvokeAsync()">
    <div class="dialog" role="alertdialog" aria-modal="true" aria-labelledby="confirm-title" @onclick:stopPropagation="true">
      <h2 id="confirm-title">Delete all log entries?</h2>
      <p>This permanently removes every entry in the log. It can't be undone.</p>
      <div class="actions">
        <button type="button" class="btn-cancel" @onclick="() => OnConfirm.InvokeAsync(false)">Cancel</button>
        <button type="button" class="btn-delete" @onclick="() => OnConfirm.InvokeAsync(true)">Delete all</button>
      </div>
    </div>
  </div>
}

@code {
  [Parameter] public bool IsVisible { get; set; }
  [Parameter] public EventCallback<bool> OnConfirm { get; set; }
  [Parameter] public EventCallback OnClose { get; set; }
}
