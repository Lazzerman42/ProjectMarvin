@page "/"
@inject NavigationManager navMan
@using Marvin.Common
@attribute [Authorize]

<PageTitle>Realtime Log</PageTitle>

<div>
	<SectionContent SectionName="nav-status">
		<span class="signalr-status @(IsConnected ? "connected" : "disconnected")" role="status" title="@(IsConnected ? "SignalR connected" : "SignalR disconnected")">
			<span class="signalr-dot"></span><span class="signalr-label">@(IsConnected ? "Live" : "Offline")</span>
		</span>
	</SectionContent>
	<SectionContent SectionName="top-bar">
		<div class="container-fluid">
			<div class="row">
				<div class="col">
					<div class="d-flex justify-content-center align-items-center">
						<div class="d-flex flex-wrap gap-1 align-items-center justify-content-center">
							<button @onclick="ShowConfirmDialog" class="BtnLeft BtnDanger">Delete all</button>
							<Confirm IsVisible="@_showDialog" OnConfirm="HandleConfirmationAsync" OnClose="CloseDialog" />
							<button class="BtnLeft" @onclick="ClearFiltersAsync">Clear Filters</button>
							<button @onclick="ShowDistinctsAsync" class="BtnLeft">Toggle Show Latest</button>
							<button type="button" class="BtnLeft theme-toggle" title="Switch light/dark mode" aria-label="Switch light/dark mode" onclick="toggleTheme()">◐</button>
						</div>
					</div>
				</div>
			</div>
		</div>
	</SectionContent>

	<div class="grid-container"><Paginator State="@_pagination" /></div>

	<div class="table-scroll-wrapper">
		<QuickGrid TGridItem="LogEntry" ItemsProvider="LoadLogEntriesAsync" @ref="_myLogGrid" Pagination="@_pagination" RowClass="@(m => TypeClass(m.LogType))">
			<PropertyColumn Property="m => m.LogDate" Title="LogDate" Format="dd-MM-yy HH:mm:ss" Class="LogDate" Sortable="true" IsDefaultSortColumn InitialSortDirection="SortDirection.Descending" Align="Align.Start" />
			<TemplateColumn Title="IP Address" SortBy="@_sortByIp" Align="Align.Left" Class="LogIPAdress">
				<ChildContent Context="m">
					<a href="@($"http://{m.IPAdress}")" target="_blank">@m.IPAdress</a>
				</ChildContent>
			</TemplateColumn>
			<TemplateColumn Title="Class" Class="LogType" SortBy="@_sortByType" Align="Align.Left">
				<span class="log-pill @TypeClass(context.LogType)">@context.LogType</span>
			</TemplateColumn>
			<PropertyColumn Property="m => m.Sender" Sortable="true" Align="Align.Left" Title="@SearchSenderFilterTitle" Class="searchGlass LogSender">
				<ColumnOptions>
					<input type="Search" autofocus @bind="_searchSenderFilter" @bind:event="oninput" @bind:after="RefreshGridAsync" placeholder="Sender..." />
				</ColumnOptions>
			</PropertyColumn>
			<PropertyColumn Property="m => m.Message" Sortable="true" Align="Align.Left" Class="searchGlass LogMessage" Title="@SearchMesssageFilterTitle">
				<ColumnOptions>
					<input type="Search" autofocus @bind="_searchMessageFilter" @bind:event="oninput" @bind:after="RefreshGridAsync" placeholder="Message..." />
				</ColumnOptions>
			</PropertyColumn>
		</QuickGrid>
	</div>
</div>




