@page "/"
@using Marvin.Common
@attribute [Authorize]

<PageTitle>Log · Project Marvin</PageTitle>

<SectionContent SectionName="nav-status">
	<span class="live @(IsConnected ? "on" : "off")" role="status" title="@(IsConnected ? "SignalR connected" : "SignalR disconnected")">
		<span class="live-dot"></span>@(IsConnected ? "Live" : "Offline")
	</span>
</SectionContent>
<SectionContent SectionName="nav-log-count">
	<span class="tab-count">@_allTotal</span>
</SectionContent>

<div class="log-page">
	<header class="log-title">
		<h1>Log</h1>
		<div class="subtitle">@Subtitle</div>
	</header>

	<section class="log-card">
		<div class="toolbar">
			<label class="search">
				<svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><circle cx="7" cy="7" r="5" fill="none" stroke="currentColor" stroke-width="1.6" /><path d="M11 11l3.5 3.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg>
				<input type="search" placeholder="Search sender, message or IP" aria-label="Search sender, message or IP"
					   value="@_query" @oninput="OnQueryInputAsync" />
			</label>
			<div class="seg" role="group" aria-label="Level">
				@foreach (var level in Levels)
				{
					<button type="button" class="@(level == _level ? "active" : null)" aria-pressed="@(level == _level)" @onclick="() => SetLevelAsync(level)">@level</button>
				}
			</div>
			@if (HasFilters)
			{
				<button type="button" class="link-btn desk" @onclick="ClearFiltersAsync">Clear filters</button>
			}
			<span class="divider desk"></span>
			<button type="button" class="ghost-btn desk" role="switch" aria-checked="@_showLatest" title="Show only the latest entry per device" @onclick="ToggleShowLatestAsync">
				<span class="switch @(_showLatest ? "on" : null)"><span class="knob"></span></span>Show latest
			</button>
			<span class="divider desk"></span>
			<button type="button" class="danger-btn desk" @onclick="ShowConfirmDialog">Delete all</button>
		</div>

		<div class="meta mob">
			<span>
				@CountLabel
				@if (HasFilters)
				{
					<button type="button" class="link-btn" @onclick="ClearFiltersAsync">Clear</button>
				}
			</span>
			<button type="button" class="latest-mob" role="switch" aria-checked="@_showLatest" title="Show only the latest entry per device" @onclick="ToggleShowLatestAsync">
				Show latest<span class="switch @(_showLatest ? "on" : null)"><span class="knob"></span></span>
			</button>
		</div>

		<div class="scroll" @ref="_scrollEl">
			<div class="log-row head">
				<button type="button" class="h" @onclick="() => SortByAsync(SortColumn.Time)">Time<span class="arrow @ArrowClass(SortColumn.Time)">@Arrow(SortColumn.Time)</span></button>
				<button type="button" class="h" @onclick="() => SortByAsync(SortColumn.Level)">Level<span class="arrow @ArrowClass(SortColumn.Level)">@Arrow(SortColumn.Level)</span></button>
				<button type="button" class="h" @onclick="() => SortByAsync(SortColumn.Sender)">Sender<span class="arrow @ArrowClass(SortColumn.Sender)">@Arrow(SortColumn.Sender)</span></button>
				<button type="button" class="h" @onclick="() => SortByAsync(SortColumn.Ip)">IP address<span class="arrow @ArrowClass(SortColumn.Ip)">@Arrow(SortColumn.Ip)</span></button>
				<button type="button" class="h" @onclick="() => SortByAsync(SortColumn.Message)">Message<span class="arrow @ArrowClass(SortColumn.Message)">@Arrow(SortColumn.Message)</span></button>
			</div>

			@foreach (var entry in _items)
			{
				<div class="log-row @TypeClass(entry.LogType)" @key="entry.Id">
					<div class="c-time"><span class="time">@entry.LogDate?.ToString("HH:mm:ss")</span><span class="date">@entry.LogDate?.ToString("dd-MM-yy")</span></div>
					<div class="c-level"><span class="badge"><span class="dot"></span>@entry.LogType</span></div>
					<div class="c-sender">@Highlight(entry.Sender)</div>
					<div class="c-ip"><a href="@($"http://{entry.IPAdress}")" target="_blank" rel="noopener">@Highlight(entry.IPAdress)</a></div>
					<div class="c-msg">@Highlight(entry.Message)</div>
				</div>
			}

			@if (_loaded && _items.Count == 0)
			{
				<div class="empty">No log entries match</div>
			}

			<div class="sentinel" @ref="_sentinel">
				@if (_loading)
				{
					<span>Loading…</span>
				}
			</div>
		</div>

		<footer class="foot">
			<span class="desk">@CountLabel</span>
			<button type="button" class="danger-btn mob" @onclick="ShowConfirmDialog">Delete all</button>
			<button type="button" class="top-btn" title="Back to top" aria-label="Back to top" @onclick="ScrollToTopAsync">
				<svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d="M8 13V3M3.5 7.5L8 3l4.5 4.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
			</button>
		</footer>
	</section>

	<Confirm IsVisible="@_showDialog" OnConfirm="HandleConfirmationAsync" OnClose="CloseDialog" />
</div>
