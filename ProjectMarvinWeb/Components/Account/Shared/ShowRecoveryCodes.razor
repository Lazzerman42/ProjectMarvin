<section class="panel">
    <div class="panel-head">
        <h2>Recovery codes</h2>
        <p>Each code logs you in once if you lose the device with your authenticator app.</p>
    </div>

    <StatusMessage Message="@StatusMessage" />

    <div class="alert alert-warning" role="alert"><span>Put these codes somewhere safe now. They won't be shown again.</span></div>

    <div class="codes">
        @foreach (var recoveryCode in RecoveryCodes)
        {
            <span>@recoveryCode</span>
        }
    </div>

    <div class="actions">
        <a href="Account/Manage/TwoFactorAuthentication" class="btn btn-secondary">Done</a>
    </div>
</section>

@code {
    [Parameter]
    public string[] RecoveryCodes { get; set; } = [];

    [Parameter]
    public string? StatusMessage { get; set; }
}
