@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Identity
@using ProjectMarvin.Data

@inject SignInManager<ApplicationUser> SignInManager

@* Shows nothing until an external login provider (Microsoft, Google ...) is configured *@
@if (externalLogins.Length > 0)
{
    <form class="stack-sm" action="Account/PerformExternalLogin" method="post">
        <AntiforgeryToken />
        <input type="hidden" name="ReturnUrl" value="@ReturnUrl" />
        @foreach (var provider in externalLogins)
        {
            <button type="submit" class="btn btn-secondary btn-block" name="provider" value="@provider.Name" title="Log in using your @provider.DisplayName account">Continue with @provider.DisplayName</button>
        }
    </form>
}

@code {
    private AuthenticationScheme[] externalLogins = [];

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    protected override async Task OnInitializedAsync()
    {
        externalLogins = (await SignInManager.GetExternalAuthenticationSchemesAsync()).ToArray();
    }
}
