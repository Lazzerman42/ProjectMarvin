@inherits LayoutComponentBase
@layout AccountLayout

<div class="acct-manage">
    <AuthorizeView>
        <div class="acct-manage-head">
            <span class="avatar-lg" aria-hidden="true">@Initial(context.User.Identity?.Name)</span>
            <div>
                <h1>Account</h1>
                <p class="muted">@context.User.Identity?.Name</p>
            </div>
        </div>
    </AuthorizeView>

    <div class="acct-manage-body">
        <ManageNavMenu />
        <div class="acct-panels">
            @Body
        </div>
    </div>
</div>

@code {
    private static string Initial(string? name) =>
        string.IsNullOrEmpty(name) ? "?" : char.ToUpperInvariant(name[0]).ToString();
}
