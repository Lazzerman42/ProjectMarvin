@page "/Account/Lockout"

<PageTitle>Account locked · Project Marvin</PageTitle>

<div class="acct-auth">
    <div class="acct-card">
        <div class="acct-head">
            <span class="acct-icon danger" aria-hidden="true">
                <svg viewBox="0 0 16 16" width="18" height="18"><rect x="3" y="7" width="10" height="7" rx="1.75" fill="none" stroke="currentColor" stroke-width="1.4" /><path d="M5.25 7V5a2.75 2.75 0 0 1 5.5 0v2" fill="none" stroke="currentColor" stroke-width="1.4" /></svg>
            </span>
            <h1>Account locked</h1>
            <p class="muted">Too many failed login attempts. Try again in 15 minutes.</p>
        </div>
        <a href="Account/Login" class="btn btn-secondary btn-block">Back to log in</a>
    </div>
</div>

