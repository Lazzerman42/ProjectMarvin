@page "/Account/ResetPasswordConfirmation"
<PageTitle>Password reset · Project Marvin</PageTitle>

<div class="acct-auth">
    <div class="acct-card">
        <div class="acct-head">
            <span class="acct-icon success" aria-hidden="true">
                <svg viewBox="0 0 16 16" width="18" height="18"><path d="m3.5 8.5 3 3 6-6.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
            </span>
            <h1>Password reset</h1>
            <p class="muted">Your password has been changed.</p>
        </div>
        <a href="Account/Login" class="btn btn-secondary btn-block">Log in</a>
    </div>
</div>

