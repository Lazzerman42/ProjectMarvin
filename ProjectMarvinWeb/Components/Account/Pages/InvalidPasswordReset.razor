@page "/Account/InvalidPasswordReset"

<PageTitle>Invalid reset link · Project Marvin</PageTitle>

<div class="acct-auth">
    <div class="acct-card">
        <div class="acct-head">
            <span class="acct-icon danger" aria-hidden="true">
                <svg viewBox="0 0 16 16" width="18" height="18"><path d="M8 2 1.75 13.5h12.5z" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" /><path d="M8 6.5v3.25M8 11.75v.25" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg>
            </span>
            <h1>Invalid reset link</h1>
            <p class="muted">The password reset link is invalid or has expired.</p>
        </div>
        <a href="Account/Login" class="btn btn-secondary btn-block">Back to log in</a>
    </div>
</div>

