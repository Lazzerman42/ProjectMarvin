@page "/Account/Manage/PersonalData"

@using Microsoft.AspNetCore.Identity
@using ProjectMarvin.Data

@inject UserManager<ApplicationUser> UserManager
@inject IdentityRedirectManager RedirectManager

<PageTitle>Personal data · Project Marvin</PageTitle>

<StatusMessage />

<section class="panel">
    <div class="panel-head">
        <h2>Download your data</h2>
        <p>Get the personal data stored for your account as a JSON file.</p>
    </div>
    <form action="Account/Manage/DownloadPersonalData" method="post">
        <AntiforgeryToken />
        <button class="btn btn-secondary" type="submit">Download</button>
    </form>
</section>

<section class="panel danger-zone">
    <div class="panel-head">
        <h2>Delete account</h2>
        <p>Permanently removes your account and everything stored about it. This can't be undone.</p>
    </div>
    <div class="actions">
        <a href="Account/Manage/DeletePersonalData" class="btn btn-ghost-danger">Delete account</a>
    </div>
</section>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        if (await UserManager.GetUserAsync(HttpContext.User) is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
        }
    }
}
