@page "/Account/ForgotPasswordConfirmation"

<PageTitle>Check your email · Project Marvin</PageTitle>

<div class="acct-auth">
    <div class="acct-card">
        <div class="acct-head">
            <span class="acct-icon" aria-hidden="true">
                <svg viewBox="0 0 16 16" width="18" height="18"><rect x="2" y="3.5" width="12" height="9" rx="1.75" fill="none" stroke="currentColor" stroke-width="1.4" /><path d="m2.5 4.5 5.5 4.25 5.5-4.25" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" /></svg>
            </span>
            <h1>Check your email</h1>
            <p class="muted">If the account exists, a link to reset the password has been sent.</p>
        </div>
        <a href="Account/Login" class="btn btn-secondary btn-block">Back to log in</a>
    </div>
</div>

